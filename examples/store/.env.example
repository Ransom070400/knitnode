# A funded 0G Galileo testnet private key (0x-prefixed). Get testnet OG from
# the faucet: https://docs.0g.ai/developer-hub/testnet/faucet
KNIT_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Where to persist the index snapshot + replay cursor. Re-running the demo
# resumes from here instead of replaying the whole stream again.
KNIT_CHECKPOINT_DIR=.knit-checkpoints

# Optional network overrides (defaults target Galileo V3):
# KNIT_EVM_RPC=https://evmrpc-testnet.0g.ai
# KNIT_FLOW_CONTRACT=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296
# KNIT_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
# KNIT_CHAIN_ID=16601
